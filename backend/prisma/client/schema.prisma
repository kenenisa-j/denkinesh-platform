datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

// Phase 10: Admin Authentication Table
model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  @@map("admins")
}

model Project {
  id       String @id @default(uuid())
  title    String
  slug     String @unique
  category String // e.g., "Web App", "Automation", "ERP"

  // Dual-Summary Architecture
  businessSummary  String @db.Text // Clear, non-technical value proposition for clients
  technicalSummary String @db.Text // In-depth technical architecture breakdown for engineers

  // Media & Metadata Assets
  thumbnailUrl String
  liveUrl      String?
  githubUrl    String?

  // Arrays for search indexing and categorization filtering
  tags     String[] // e.g., ["Next.js", "Prisma", "PostgreSQL"]
  features String[] // e.g., ["QR Check-in", "Real-time Analytics"]

  // Status flags
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
  @@index([slug])
}

model TeamMember {
  id          String   @id @default(uuid())
  name        String
  role        String // e.g., "Lead Full-Stack Engineer", "AI Specialist"
  avatarUrl   String // Profile picture file string/URL
  bio         String   @db.Text
  specialties String[] // Array tracking operational skill vectors (e.g., ["React", "Node.js", "LLMs"])

  // Optional external profiles
  githubUrl   String?
  linkedinUrl String?
  twitterUrl  String?

  // System tracking attributes
  order     Int      @default(0) // Allows custom sorting order on the frontend directory
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Add this model to your backend/prisma/schema.prisma file

model Testimonial {
  id           String   @id @default(uuid())
  clientName   String // Name of the reviewer
  companyName  String? // Optional company identifier/industry
  role         String? // Client's corporate title (e.g., Founder, PM)
  avatarUrl    String? // Optional profile picture URL
  feedbackText String   @db.Text // The verified rating review content
  ratingValue  Int      @default(5) // Numerical score (e.g., 1 to 5 stars)
  order        Int      @default(0) // Integer value to arrange presentation sequence
  isActive     Boolean  @default(true) // Admin visibility toggle control
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("testimonials") // Maps model to lowercase table name in PostgreSQL
}

// Add this model to your backend/prisma/schema.prisma file

model ContactMessage {
  id        String   @id @default(uuid())
  name      String // Sender's name
  email     String // Sender's email address
  subject   String // Subject of the inquiry
  message   String   @db.Text // The raw message content
  isRead    Boolean  @default(false) // Admin review state toggle
  createdAt DateTime @default(now())

  @@map("contact_messages") // Maps model to lowercase table name in PostgreSQL
}

// Add this model to your backend/prisma/schema.prisma file

model Lead {
  id             String   @id @default(uuid())
  clientName     String // Contact person's name
  email          String // Contact email address
  company        String // Client company/organization name
  budget         Float // Project budget estimation parameter
  projectDetails String   @db.Text // Full breakdown of the project requirements
  aiScore        String   @default("LOW") // Automated prioritization matrix rating: LOW | MEDIUM | HIGH
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("leads") // Map model to lowercase database table name
}
