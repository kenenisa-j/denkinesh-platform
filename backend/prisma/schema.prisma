datasource db {
  provider = "postgresql"
  // The 'url' line is removed from here entirely in Prisma 7
}

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

// =========================================================================
// Phase 10: Admin Authentication Security Configuration
// =========================================================================
model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // Stores the secure bcrypt salted password hash
  firstName String?
  lastName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("admins")
}

// =========================================================================
// Corporate Project Evidence Validation
// =========================================================================
model Project {
  id       String @id @default(uuid())
  title    String
  slug     String @unique
  category String // e.g., "Web App", "Automation", "ERP"

  // Dual-Summary Architecture
  businessSummary  String @db.Text // Clear, non-technical value proposition for clients
  technicalSummary String @db.Text // In-depth technical architecture breakdown for engineers

  // Media & Metadata Assets
  thumbnailUrl String
  liveUrl      String?
  githubUrl    String?

  // Arrays for search indexing and categorization filtering
  tags     String[] // e.g., ["Next.js", "Prisma", "PostgreSQL"]
  features String[] // e.g., ["QR Check-in", "Real-time Analytics"]

  // Status flags
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
  @@index([slug])
  @@map("projects")
}

// =========================================================================
// Team & Organizational Profiles
// =========================================================================
model TeamMember {
  id          String   @id @default(uuid())
  name        String
  role        String // e.g., "Lead Full-Stack Engineer", "AI Specialist"
  avatarUrl   String // Profile picture file string/URL
  bio         String   @db.Text
  specialties String[] // Array tracking operational skill vectors (e.g., ["React", "Node.js"])

  // Optional external profiles
  githubUrl   String?
  linkedinUrl String?
  twitterUrl  String?

  // System tracking attributes
  order     Int      @default(0) // Allows custom sorting order on the frontend directory
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("team_members")
}

// =========================================================================
// Verified Client Social Proof
// =========================================================================
model Testimonial {
  id           String   @id @default(uuid())
  clientName   String // Name of the reviewer
  companyName  String? // Optional company identifier/industry
  role         String? // Client's corporate title (e.g., Founder, PM)
  avatarUrl    String? // Optional profile picture URL
  feedbackText String   @db.Text // The verified rating review content
  ratingValue  Int      @default(5) // Numerical score (e.g., 1 to 5 stars)
  order        Int      @default(0) // Integer value to arrange presentation sequence
  isActive     Boolean  @default(true) // Admin visibility toggle control
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("testimonials")
}

// =========================================================================
// Lead Ingestion & Communications Management
// =========================================================================
model ContactMessage {
  id        String   @id @default(uuid())
  name      String // Sender's name
  email     String // Sender's email address
  subject   String // Subject of the inquiry
  message   String   @db.Text // The raw message content
  isRead    Boolean  @default(false) // Admin review state toggle
  createdAt DateTime @default(now())

  @@map("contact_messages")
}

model Lead {
  id             String   @id @default(uuid())
  clientName     String // Contact person's name
  email          String // Contact email address
  company        String // Client company/organization name
  budget         Float // Project budget estimation parameter
  projectDetails String   @db.Text // Full breakdown of the project requirements
  aiScore        String   @default("LOW") // Automated prioritization matrix rating: LOW | MEDIUM | HIGH
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("leads")
}

// =========================================================================
// Phase 9: AI Conversational Intent Harvesting
// =========================================================================
model AISession {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Buyer Intent Harvesting Metadata
  capturedName  String? // Populated if user reveals name during chat
  capturedEmail String? // Populated if user provides email
  businessPain  String? // Inferred core operational problem tracking
  budgetIntent  String? // Inferred investment scale tracking

  // Message Log Relation
  messages AIMessage[]

  @@index([createdAt])
  @@map("ai_sessions")
}

model AIMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      Role // Enum defining sender structure (user or system/assistant)
  content   String   @db.Text
  createdAt DateTime @default(now())

  // Relationships
  session AISession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("ai_messages")
}

enum Role {
  user
  assistant
  system
}
model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Will store the cryptographically hashed string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}